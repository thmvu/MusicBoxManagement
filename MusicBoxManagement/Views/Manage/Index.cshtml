@model MusicBoxManagement.Models.IndexViewModel
@{
    ViewBag.Title = "Tài khoản của tôi";
}

<main class="py-4">
    <div class="page-heading">
        <div><p class="page-context">Music Box / Cá nhân</p><h1>Tài khoản của tôi</h1></div>
    </div>
    @if (!string.IsNullOrEmpty(ViewBag.StatusMessage))
    {
        <div class="alert alert-success" role="status">@ViewBag.StatusMessage</div>
    }
    <section class="account-settings">
        <h2>Bảo mật tài khoản</h2>
        <p>Quản lý mật khẩu dùng để đăng nhập hệ thống.</p>
        @if (Model.HasPassword)
        {
            @Html.ActionLink("Đổi mật khẩu", "ChangePassword", "Manage", null, new { @class = "btn btn-outline-primary" })
        }
        else
        {
            @Html.ActionLink("Tạo mật khẩu", "SetPassword", "Manage", null, new { @class = "btn btn-outline-primary" })
        }
    </section>
</main>

@using Microsoft.AspNet.Identity
@if (Request.IsAuthenticated)
{
    using (Html.BeginForm("LogOff", "Account", FormMethod.Post, new { id = "logoutForm", @class = "nav-account" }))
    {
        @Html.AntiForgeryToken()
        @Html.ActionLink(User.Identity.GetUserName(), "Index", "Manage", null, new { @class = "account-name", title = "Tài khoản của tôi" })
        <button type="submit" class="account-logout">Đăng xuất</button>
    }
}
else
{
    @Html.ActionLink("Đăng nhập nội bộ", "Login", "Account", null, new { @class = "account-login" })
}

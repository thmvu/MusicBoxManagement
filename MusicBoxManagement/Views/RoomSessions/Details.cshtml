@using System.Globalization
@model MusicBoxManagement.Models.RoomSessionDetailsViewModel
@{
    ViewBag.Title = "Chi tiết phiên sử dụng";
    var offset = TimeSpan.FromHours(7);
    var vietnamese = CultureInfo.GetCultureInfo("vi-VN");
}

<main class="py-4">
    <p>@Html.ActionLink("← Phiên đang hoạt động", "Index", "RoomSessions")</p>
    <h1>Phiên sử dụng #@Model.RoomSessionId</h1>
    @if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
    @if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }
    <dl class="row">
        <dt class="col-sm-3">Phòng</dt><dd class="col-sm-9">@Model.RoomName (@Model.RoomCodeSnapshot · @Model.RoomTypeNameSnapshot)</dd>
        <dt class="col-sm-3">Khách</dt><dd class="col-sm-9">@Model.CustomerName · @Model.PhoneNumber</dd>
        <dt class="col-sm-3">Bắt đầu thực tế</dt><dd class="col-sm-9">@Model.ActualStartTime.ToOffset(offset).ToString("dd/MM/yyyy HH:mm", vietnamese)</dd>
        <dt class="col-sm-3">Giá đã chốt</dt><dd class="col-sm-9">@Model.HourlyRate.ToString("N0", vietnamese) đ/giờ</dd>
        <dt class="col-sm-3">Trạng thái</dt><dd class="col-sm-9">@(Model.Status == "Active" ? "Đang sử dụng" : "Hoàn tất")</dd>
        @if (Model.ReservationId.HasValue)
        {
            <dt class="col-sm-3">Nguồn</dt><dd class="col-sm-9">Đặt trước #@Model.ReservationId</dd>
            <dt class="col-sm-3">Dự kiến kết thúc</dt><dd class="col-sm-9">@Model.ExpectedEndTime.Value.ToOffset(offset).ToString("dd/MM/yyyy HH:mm", vietnamese)</dd>
        }
        else
        {
            <dt class="col-sm-3">Nguồn</dt><dd class="col-sm-9">Khách trực tiếp</dd>
            if (Model.WarningEndUtc.HasValue)
            {
                <dt class="col-sm-3">Giờ cần trả phòng</dt><dd class="col-sm-9">@Model.WarningEndUtc.Value.ToOffset(offset).ToString("dd/MM/yyyy HH:mm", vietnamese) <span class="text-muted">(cảnh báo, cập nhật theo booking mới)</span></dd>
            }
        }
    </dl>
    @if (Model.Billing != null)
    {
        <section class="border-top pt-3 mt-4">
            <h2 class="h5">Tiền tạm tính</h2>
            <p class="text-muted">Cập nhật lúc @Model.Billing.UpdatedAt.ToOffset(offset).ToString("HH:mm:ss dd/MM/yyyy", vietnamese). Chỉ cộng món đã phục vụ.</p>
            <dl class="row">
                <dt class="col-sm-3">Thời gian đã dùng</dt><dd class="col-sm-9">@Model.Billing.UsedMinutes.ToString("N1", vietnamese) phút</dd>
                <dt class="col-sm-3">Tiền phòng</dt><dd class="col-sm-9">@Model.Billing.RoomCharge.ToString("N0", vietnamese) đ</dd>
                <dt class="col-sm-3">Món đã phục vụ</dt><dd class="col-sm-9">@Model.Billing.ServiceCharge.ToString("N0", vietnamese) đ</dd>
                <dt class="col-sm-3">Tổng tạm tính</dt><dd class="col-sm-9"><strong>@Model.Billing.TotalAmount.ToString("N0", vietnamese) đ</strong></dd>
            </dl>
            <a class="btn btn-outline-secondary" href="@Url.Action("Details", new { id = Model.RoomSessionId })">Cập nhật tiền tạm tính</a>
        </section>
    }
    @if (Model.CanViewOrders || Model.CanCreateOrder)
    {
        <div class="d-flex gap-2 mt-3">
            @if (Model.CanViewOrders) { @Html.ActionLink("Xem đơn món", "Index", "Orders", new { sessionId = Model.RoomSessionId }, new { @class = "btn btn-outline-primary" }) }
            @if (Model.CanCreateOrder) { @Html.ActionLink("Ghi món đã phục vụ", "Create", "Orders", new { sessionId = Model.RoomSessionId }, new { @class = "btn btn-primary" }) }
        </div>
    }
    @if (Model.CanExtend)
    {
        <section class="card mt-4"><div class="card-body">
            <h2 class="h5">Gia hạn phiên</h2>
            <p>Gia hạn từ giờ dự kiến kết thúc hiện tại. Hệ thống sẽ kiểm tra lại ca mở cửa và lịch phòng/khách.</p>
            <div class="d-flex gap-2">
                @foreach (var minutes in new[] { 30, 60 })
                {
                    using (Html.BeginForm("Extend", "RoomSessions", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.RoomSessionId" />
                        <input type="hidden" name="minutes" value="@minutes" />
                        <button type="submit" class="btn btn-outline-primary">+@minutes phút</button>
                    }
                }
            </div>
        </div></section>
    }
</main>
